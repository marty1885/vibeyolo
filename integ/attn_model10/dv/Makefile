REPO_ROOT := $(shell git rev-parse --show-toplevel 2>/dev/null)
ifeq ($(REPO_ROOT),)
REPO_ROOT := $(abspath $(CURDIR)/../../..)
endif

S_DIR    := $(REPO_ROOT)/integ/attn_model10/rtl
STIM_DIR := $(REPO_ROOT)/integ/attn_model10/stim

TB_TOP := attn_tb

# attn_scales_pkg.sv is generated by extract.py; it must appear before
# attn_tb.sv on the verilator command line (handled via RTL_SRCS order).
RTL_SRCS := \
  $(STIM_DIR)/attn_scales_pkg.sv \
  $(S_DIR)/attn.sv \
  $(CURDIR)/attn_tb.sv

CC_SRCS := $(CURDIR)/attn_test.cc

LINT_FLAGS := -Wno-UNOPTFLAT -Wno-ASCRANGE -Wno-SELRANGE -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-REALCVT -Wno-BLKSEQ
VERILATOR_THREADS ?= 1

include $(REPO_ROOT)/mk/verilator.mk

.PHONY: stim
stim: $(STIM_DIR)/.stim.stamp

$(STIM_DIR)/.stim.stamp: $(REPO_ROOT)/integ/attn_model10/extract.py
	python3 $(REPO_ROOT)/integ/attn_model10/extract.py
	touch $@

# Force ordering: the verilator build depends on stim because
# attn_scales_pkg.sv is generated by extract.py.
$(STIM_DIR)/attn_scales_pkg.sv: $(STIM_DIR)/.stim.stamp
	@:

test: stim

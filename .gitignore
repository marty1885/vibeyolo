# Verilator build artifacts
**/dv/build/
**/dv/obj/
**/dv/build_*/
**/*.o
**/*.d
**/*.a

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Generated stimulus (re-derivable from extract.py)
**/stim/*.hex
**/stim/*.bin
**/stim/*.npy
**/stim/*.i8
**/stim/*.f32
**/stim/manifest.json
**/stim/.stim.stamp
# Auto-generated per-block scale packages (re-derivable from extract.py).
**/stim/*_scales_pkg.sv
**/stim/s_out_params.sv

# Batch-run logs / scratch reports
**/_batch_logs/
**/_batch_*/

# Scale experiments (re-derivable from layergen.py)
integ/generated/scale_experiments/

# Large intermediate ONNX files (re-derivable)
**/_model_with_intermediate.onnx

# E2E co-sim Verilator build tree (large, re-derivable from tools/e2e)
tools/e2e/cosim/build/
# E2E generated activations / hex / onnx / npy / report (re-derivable)
integ/generated/e2e/
# Derived input tensors (re-derivable from source images)
assets/*.npy
# Calibration image corpora (GB-scale, re-downloadable: COCO val2017 + QOI suite)
assets/calib/
# Generated PDK reports (re-derivable from tools/chip_area.py, power.py, sram_bw.py)
reports/
# Physical design (P&R): generated netlists, layouts, LEF, logs (re-derivable
# from the pnr/*.tcl + pnr/*.sh scripts and the block RTL; .def alone is 100s of MB)
pnr/**/*.v
pnr/**/*.netlist.v
pnr/**/*.def
pnr/**/*.lef
pnr/**/*.log
pnr/**/*.out
# Formal SEC scratch tree (re-derivable from formal/Makefile)
formal/work/

# yosys/abc scratch + local scheduler state
abc.history
.claude/

# Coverage / lint
**/coverage/
**/*.dat
**/*.coverage
*.vcd
*.fst

# Editor
.vscode/
.idea/
*.swp
*~
.DS_Store
